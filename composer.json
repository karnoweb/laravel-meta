{
    "name": "karnoweb/laravel-meta",
    "description": "Typed, optionally versioned metadata for Laravel Eloquent models.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "meta",
        "metadata",
        "eloquent",
        "versioning"
    ],
    "authors": [
        {
            "name": "Karnoweb",
            "email": "info@karnoweb.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\Meta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\Meta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\Meta\\MetaServiceProvider"
            ],
            "aliases": {
                "Meta": "Karnoweb\\Meta\\Facades\\Meta"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
